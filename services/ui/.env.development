# Frontend Environment Variables

# API Configuration
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws

# Feature Flags
VITE_ENABLE_MOCKS=true
VITE_ENABLE_DEVTOOLS=true

# Sentry (Error Tracking) - Add your DSN when ready
# VITE_SENTRY_DSN=

# Optional: Analytics
# VITE_ANALYTICS_ID=
