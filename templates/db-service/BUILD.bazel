load("@rules_proto//proto:defs.bzl", "proto_library")
load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@com_github_grpc_grpc//bazel:cc_grpc_library.bzl", "cc_grpc_library")

# Protocol Buffer Library
proto_library(
    name = "product_proto",
    srcs = [
        "api/v1/common.proto",
        "api/v1/product.proto",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@com_google_protobuf//:timestamp_proto",
        "@com_google_protobuf//:empty_proto",
    ],
)

# Go Protocol Buffer Library
go_proto_library(
    name = "product_go_proto",
    compilers = ["@io_bazel_rules_go//proto:go_grpc"],
    importpath = "grouter/templates/db-service/api/v1",
    proto = ":product_proto",
    visibility = ["//visibility:public"],
    deps = [
        "@org_golang_google_protobuf//types/known/timestamppb",
        "@org_golang_google_protobuf//types/known/emptypb",
    ],
)

# Product Domain Package
go_library(
    name = "products",
    srcs = [
        "internal/pkg/products/model.go",
        "internal/pkg/products/repository.go",
    ],
    importpath = "grouter/templates/db-service/internal/pkg/products",
    visibility = ["//visibility:public"],
    deps = [
        ":product_go_proto",
        "//pkg/database",
        "@io_gorm_gorm//:gorm",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

# gRPC Server Package
go_library(
    name = "grpc",
    srcs = ["internal/grpc/product_server.go"],
    importpath = "grouter/templates/db-service/internal/grpc",
    visibility = ["//visibility:public"],
    deps = [
        ":product_go_proto",
        ":products",
        "@org_uber_go_zap//:zap",
        "@org_golang_google_grpc//:go_default_library",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//types/known/emptypb",
        "@io_gorm_gorm//:gorm",
    ],
)

# Config Package
go_library(
    name = "config",
    srcs = ["internal/config/config.go"],
    importpath = "grouter/templates/db-service/internal/config",
    visibility = ["//visibility:public"],
)

# App Package
go_library(
    name = "app",
    srcs = ["internal/app/app.go"],
    importpath = "grouter/templates/db-service/internal/app",
    visibility = ["//visibility:public"],
    deps = [
        ":config",
        ":grpc",
        ":product_go_proto",
        ":products",
        "//pkg/database",
        "//pkg/manager",
        "@com_github_grpc_ecosystem_go_grpc_middleware//:go-grpc-middleware",
        "@com_github_grpc_ecosystem_go_grpc_middleware//logging/zap",
        "@com_github_grpc_ecosystem_go_grpc_middleware//recovery",
        "@com_github_grpc_ecosystem_go_grpc_prometheus//:go-grpc-prometheus",
        "@com_github_prometheus_client_golang//prometheus/promhttp",
        "@org_uber_go_zap//:zap",
        "@org_golang_google_grpc//:go_default_library",
        "@org_golang_google_grpc//health",
        "@org_golang_google_grpc//health/grpc_health_v1",
        "@org_golang_google_grpc//reflection",
    ],
)

# Main Binary
go_binary(
    name = "db-service",
    srcs = ["cmd/api/main.go"],
    visibility = ["//visibility:public"],
    deps = [
        ":app",
        "//pkg/config",
        "//pkg/logger",
        "//pkg/manager",
        "@org_uber_go_zap//:zap",
    ],
)

