module(
    name = "grouter",
    version = "1.0.0",
)

# Use latest stable versions for better Go 1.24 support and OpenTelemetry compatibility
bazel_dep(name = "rules_go", version = "0.50.1")
bazel_dep(name = "gazelle", version = "0.41.0")
bazel_dep(name = "rules_proto", version = "6.0.0")
bazel_dep(name = "protobuf", version = "27.0")

# Configure Go SDK
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.24.11")
use_repo(go_sdk, "go_toolchains")

# Go dependencies
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_cenkalti_backoff_v4",
    "com_github_fsnotify_fsnotify",
    "com_github_gin_contrib_cors",
    "com_github_gin_contrib_gzip",
    "com_github_gin_contrib_secure",
    "com_github_gin_gonic_gin",
    "com_github_go_viper_mapstructure_v2",
    "com_github_golang_jwt_jwt_v5",
    "com_github_google_uuid",
    "com_github_grpc_ecosystem_go_grpc_middleware",
    "com_github_grpc_ecosystem_go_grpc_prometheus",
    "com_github_grpc_ecosystem_grpc_gateway_v2",
    "com_github_nats_io_nats_go",
    "com_github_nats_io_nats_server_v2",
    "com_github_prometheus_client_golang",
    "com_github_prometheus_client_model",
    "com_github_sony_gobreaker",
    "com_github_spf13_pflag",
    "com_github_spf13_viper",
    "com_github_stretchr_testify",
    "com_github_swaggo_swag",
    "in_gopkg_natefinch_lumberjack_v2",
    "io_gorm_driver_mysql",
    "io_gorm_driver_postgres",
    "io_gorm_driver_sqlite",
    "io_gorm_gorm",
    "io_gorm_plugin_opentelemetry",
    "io_opentelemetry_go_contrib_instrumentation_github_com_gin_gonic_gin_otelgin",
    "io_opentelemetry_go_otel",
    "io_opentelemetry_go_otel_exporters_otlp_otlptrace_otlptracehttp",
    "io_opentelemetry_go_otel_exporters_stdout_stdouttrace",
    "io_opentelemetry_go_otel_sdk",
    "io_opentelemetry_go_otel_trace",
    "org_golang_google_grpc",
    "org_golang_google_protobuf",
    "org_golang_x_time",
    "org_uber_go_zap",
)
